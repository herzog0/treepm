generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ClerkRole {
  admin
  member

  @@map("clerk_role")
}

enum TeamRole {
  admin
  member

  @@map("team_role")
}

enum ProjectVisibility {
  organization
  private

  @@map("project_visibility")
}

enum ProjectRole {
  manager
  contributor
  reader

  @@map("project_role")
}

model Organization {
  orgId           String   @id @map("org_id")
  name            String
  slug            String
  /// "Permitir acesso por MCP" (ADR 0038): desligada por padrão; só um administrador liga.
  mcpEnabled      Boolean  @default(false) @map("mcp_enabled")
  /// "Permitir escrita por MCP" (ADR 0043): desligada por padrão; só um administrador liga. Com ela desligada, nenhum token escreve.
  mcpWriteEnabled Boolean  @default(false) @map("mcp_write_enabled")
  /// "Pessoas e conversas" por MCP (ADR 0062): desligada por padrão; só um administrador liga. Sem ela, nenhum token entrega nome de pessoa.
  mcpPeopleEnabled Boolean @default(false) @map("mcp_people_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  people                     Person[]
  teams                      Team[]
  teamMemberships            TeamMembership[]
  areas                      Area[]
  projects                   Project[]
  projectTeams               ProjectTeam[]
  projectMemberships         ProjectMembership[]
  tickets                    Ticket[]
  ticketAssignees            TicketAssignee[]
  ticketRelations            TicketRelation[]
  activityEvents             ActivityEvent[]
  ticketConversations        TicketConversation[]
  ticketConversationMessages TicketConversationMessage[]
  branchSummaries            BranchSummary[]
  placementDecisions         PlacementDecision[]
  ticketEmbeddings           TicketEmbedding[]
  githubInstallations        GithubInstallation[]
  projectRepositories        ProjectRepository[]
  ticketCodeLinks            TicketCodeLink[]
  repositorySyncPages        RepositorySyncPage[]
  accessTokens               AccessToken[]
  ticketComments             TicketComment[]
  conversations              Conversation[]
  conversationParticipants   ConversationParticipant[]
  conversationMessages       ConversationMessage[]
  ticketContributions        TicketContribution[]
  ticketContributionPeople   TicketContributionPerson[]
  organizationConsents       OrganizationConsent[]
  externalCredentials        ExternalCredential[]
  projectExternalSources     ProjectExternalSource[]
  ticketExternalRefs         TicketExternalRef[]
  externalItemRefs           ExternalItemRef[]
  externalHistoryEntries     ExternalHistoryEntry[]
  externalImportRuns         ExternalImportRun[]
  externalCategorizeItems    ExternalCategorizeItem[]
  projectLabels              ProjectLabel[]
  ticketLabels               TicketLabel[]
  projectLabelOrigins        ProjectLabelOrigin[]

  @@map("organizations")
}

/// ATENÇÃO: coluna nova em `people` precisa de `GRANT UPDATE (coluna)` explícito para o papel `treepm_app` (migration 0034 tirou o UPDATE da
/// tabela inteira, para `is_test` e a chave nunca mudarem). Sem o GRANT, o Prisma acusa "permission denied" ao gravar a coluna.
model Person {
  orgId       String    @map("org_id")
  id          String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  clerkUserId String    @map("clerk_user_id")
  displayName String    @map("display_name")
  email       String
  avatarUrl   String?   @map("avatar_url")
  clerkRole   ClerkRole @map("clerk_role")
  active      Boolean   @default(true)
  /// Pessoa de teste (ADR 0057): sem usuário no Clerk; marca imutável (privilégio de coluna, migration 0034).
  isTest      Boolean   @default(false) @map("is_test")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization           Organization               @relation(fields: [orgId], references: [orgId])
  teamMemberships        TeamMembership[]
  projectMemberships     ProjectMembership[]
  createdTickets         Ticket[]                   @relation("TicketCreatedBy")
  ticketsAgentWork       Ticket[]                   @relation("TicketAgentWorkPerson")
  ticketAssignees        TicketAssignee[]
  activityEvents         ActivityEvent[]
  ticketConversations    TicketConversation[]
  connectedInstallations GithubInstallation[]
  linkedRepositories     ProjectRepository[]
  editedBranchSummaries  BranchSummary[]
  accessTokens           AccessToken[]
  commentsWritten        TicketComment[]            @relation("CommentAuthor")
  commentsRemoved        TicketComment[]            @relation("CommentRemovedBy")
  conversationsOwned     Conversation[]             @relation("ConversationOwner")
  conversationMessages   ConversationMessage[]      @relation("ConversationMessageAuthor")
  conversationsJoined    ConversationParticipant[]  @relation("ConversationParticipantPerson")
  conversationsAdded     ConversationParticipant[]  @relation("ConversationParticipantAddedBy")
  contributionsCreated   TicketContribution[]       @relation("ContributionCreatedBy")
  contributionPeople     TicketContributionPerson[]
  consentsAccepted       OrganizationConsent[]      @relation("ConsentAcceptedBy")
  consentsWithdrawn      OrganizationConsent[]      @relation("ConsentWithdrawnBy")
  externalCredentials    ExternalCredential[]
  externalSourcesLinked  ProjectExternalSource[]    @relation("ExternalSourceLinkedBy")
  externalImportRunsStarted ExternalImportRun[]     @relation("ImportRunStartedBy")
  externalHistoryEntries ExternalHistoryEntry[]    @relation("HistoryEntryActor")

  @@id([orgId, id])
  @@unique([orgId, clerkUserId])
  @@map("people")
}

model Team {
  orgId     String   @map("org_id")
  id        String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [orgId], references: [orgId])
  memberships  TeamMembership[]
  projectTeams ProjectTeam[]

  @@id([orgId, id])
  @@unique([orgId, name])
  @@map("teams")
}

model TeamMembership {
  orgId     String   @map("org_id")
  teamId    String   @map("team_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  role      TeamRole @default(member)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  team         Team         @relation(fields: [orgId, teamId], references: [orgId, id], onDelete: Cascade)
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, teamId, personId])
  @@map("team_memberships")
}

model Area {
  orgId     String   @map("org_id")
  id        String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization         @relation(fields: [orgId], references: [orgId])
  contributions TicketContribution[]

  @@id([orgId, id])
  @@unique([orgId, name])
  @@map("areas")
}

model Project {
  orgId            String            @map("org_id")
  id               String            @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name             String
  key              String
  visibility       ProjectVisibility @default(organization)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  nextTicketNumber Int               @default(1) @map("next_ticket_number")
  /// Versão da lista de tickets (ADR 0046): contador incrementado em 1 pelo toque do fim da transação, sem relógio.
  ticketsVersion   BigInt            @default(0) @map("tickets_version")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [orgId], references: [orgId])
  teams               ProjectTeam[]
  memberships         ProjectMembership[]
  tickets             Ticket[]
  ticketConversations TicketConversation[]
  branchSummaries     BranchSummary[]
  placementDecisions  PlacementDecision[]
  repositories        ProjectRepository[]
  accessTokens        AccessToken[]
  externalSource      ProjectExternalSource?
  externalImportRuns  ExternalImportRun[]
  labels              ProjectLabel[]
  labelOrigins        ProjectLabelOrigin[]

  @@id([orgId, id])
  @@unique([orgId, key])
  @@map("projects")
}

model ProjectTeam {
  orgId     String   @map("org_id")
  projectId String   @map("project_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  team         Team         @relation(fields: [orgId, teamId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, projectId, teamId])
  @@map("project_teams")
}

model ProjectMembership {
  orgId     String      @map("org_id")
  projectId String      @map("project_id") @db.Uuid
  personId  String      @map("person_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, projectId, personId])
  @@map("project_memberships")
}

model Ticket {
  orgId              String    @map("org_id")
  id                 String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  number             Int
  parentId           String?   @map("parent_id") @db.Uuid
  title              String
  description        String    @default("")
  /// todo | in_progress | in_review | done | cancelled (check no banco)
  status             String    @default("todo")
  /// Estágio de ideia (ADR 0042): new | refining | ready | discarded (check no banco); só a raiz da ideia tem. Com estágio, a situação é sempre todo.
  ideaStage          String?   @map("idea_stage")
  /// Prioridade (ADR 0047): inteiro de -999 a 999 (check no banco), 0 por padrão; maior primeiro. A que vale, com herança, é calculada no domínio.
  priority           Int       @default(0)
  /// Prazo (ADR 0064): data de calendário, sem hora e sem fuso; nulo = sem prazo. De 2000-01-01 a 2100-12-31 (check no banco). Lido como meia-noite UTC: converter só por `dueDateText`.
  dueDate            DateTime? @map("due_date") @db.Date
  /// Marcador de trabalho pela IA (ADR 0043): os quatro andam juntos (check). Vale enquanto `agentWorkUntil` é futuro; nota vazia = sem nota.
  agentWorkStartedAt DateTime? @map("agent_work_started_at") @db.Timestamptz(3)
  agentWorkUntil     DateTime? @map("agent_work_until") @db.Timestamptz(3)
  agentWorkPersonId  String?   @map("agent_work_person_id") @db.Uuid
  agentWorkNote      String?   @map("agent_work_note")
  createdByPersonId  String    @map("created_by_person_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization         @relation(fields: [orgId], references: [orgId])
  project              Project              @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  parent               Ticket?              @relation("TicketTree", fields: [orgId, projectId, parentId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  children             Ticket[]             @relation("TicketTree")
  createdBy            Person               @relation("TicketCreatedBy", fields: [orgId, createdByPersonId], references: [orgId, id])
  agentWorkPerson      Person?              @relation("TicketAgentWorkPerson", fields: [orgId, agentWorkPersonId], references: [orgId, id])
  assignees            TicketAssignee[]
  conversationsCreated TicketConversation[]
  branchSummaries      BranchSummary[]
  placementDecisions   PlacementDecision[]
  embeddings           TicketEmbedding[]
  codeLinks            TicketCodeLink[]
  relationsFrom        TicketRelation[]     @relation("RelationFrom")
  relationsTo          TicketRelation[]     @relation("RelationTo")
  comments             TicketComment[]
  contributions        TicketContribution[]
  conversations        Conversation[]
  externalRefs         TicketExternalRef[]
  externalItemRefs     ExternalItemRef[]
  externalHistoryEntries ExternalHistoryEntry[]
  importRunsAsDestination ExternalImportRun[]
  categorizeItems         ExternalCategorizeItem[]
  labels                  TicketLabel[]

  @@id([orgId, id])
  @@unique([orgId, projectId, id])
  @@unique([orgId, projectId, number])
  @@index([orgId, projectId, parentId])
  @@map("tickets")
}

/// Ligação entre dois tickets do mesmo projeto (ADR 0037): "de" menciona "para" ou "de" depende de "para".
model TicketRelation {
  orgId        String   @map("org_id")
  id           String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  fromTicketId String   @map("from_ticket_id") @db.Uuid
  toTicketId   String   @map("to_ticket_id") @db.Uuid
  /// mentions | depends_on | related (check no banco; related: uma linha por par, menor id primeiro)
  kind         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  from         Ticket       @relation("RelationFrom", fields: [orgId, projectId, fromTicketId], references: [orgId, projectId, id], onDelete: Cascade)
  to           Ticket       @relation("RelationTo", fields: [orgId, projectId, toTicketId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@unique([orgId, fromTicketId, toTicketId, kind])
  @@index([orgId, toTicketId, kind])
  @@map("ticket_relations")
}

model TicketAssignee {
  orgId     String   @map("org_id")
  ticketId  String   @map("ticket_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id], onDelete: Cascade)
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, ticketId, personId])
  @@index([orgId, personId, ticketId])
  @@map("ticket_assignees")
}

/// Etiqueta do projeto (ADR 0065; migration 0048). Nome de 1 a 60 pontos de código, aparado e sem controle (check no banco; o domínio
/// limpa antes com `cleanLabelName`). `nameKey` é a chave de unicidade sem diferenciar maiúsculas, PREENCHIDA PELO DOMÍNIO (`labelNameKey`).
/// O papel da aplicação só atualiza nome, chave, cor e data (privilégio de coluna): nunca o projeto nem o id.
model ProjectLabel {
  orgId     String   @map("org_id")
  id        String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  nameKey   String   @map("name_key")
  /// gray | brown | orange | olive | cyan | indigo | violet | rose (check no banco; `LABEL_COLORS` do domínio)
  color     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [orgId], references: [orgId])
  project      Project       @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade, map: "project_labels_project_fkey")
  tickets      TicketLabel[]

  @@id([orgId, id])
  @@unique([orgId, projectId, nameKey], map: "project_labels_name_key")
  // Alvo das chaves estrangeiras compostas (etiqueta do mesmo projeto).
  @@unique([orgId, projectId, id], map: "project_labels_project_id_key")
  @@map("project_labels")
}

/// Etiqueta posta num ticket (ADR 0065; migration 0048). A chave estrangeira composta com o projeto do ticket garante que a etiqueta é do
/// MESMO projeto. Some com o ticket e com a etiqueta. A aplicação só põe e tira (sem UPDATE).
model TicketLabel {
  orgId     String   @map("org_id")
  projectId String   @map("project_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  labelId   String   @map("label_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  ticket       Ticket       @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade, map: "ticket_labels_ticket_fkey")
  label        ProjectLabel @relation(fields: [orgId, projectId, labelId], references: [orgId, projectId, id], onDelete: Cascade, onUpdate: Restrict, map: "ticket_labels_label_fkey")

  @@id([orgId, ticketId, labelId])
  @@index([orgId, labelId], map: "ticket_labels_label_idx")
  @@index([orgId, projectId], map: "ticket_labels_project_idx")
  @@map("ticket_labels")
}

model ActivityEvent {
  orgId         String   @map("org_id")
  id            String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  actorPersonId String?  @map("actor_person_id") @db.Uuid
  kind          String
  subjectType   String   @map("subject_type")
  subjectId     String   @map("subject_id")
  payload       Json     @default("{}")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  actor        Person?      @relation(fields: [orgId, actorPersonId], references: [orgId, id])

  @@id([orgId, id])
  @@index([orgId, subjectType, subjectId, occurredAt])
  @@map("activity_events")
}

/// open | ticket_created | discarded (check no banco). Remover o ticket criado só anula `createdTicketId`
/// (ON DELETE SET NULL (created_ticket_id), ação que o Prisma não modela: ver a migration 0005).
model TicketConversation {
  orgId            String    @map("org_id")
  id               String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  authorPersonId   String    @map("author_person_id") @db.Uuid
  status           String    @default("open")
  draftTitle       String?   @map("draft_title")
  draftDescription String?   @map("draft_description")
  /// Filhos do rascunho (ADR 0044): lista de `{ title, description }` na ordem do rascunho, até 20; nulo = um ticket só.
  draftChildren    Json?     @map("draft_children")
  /// Registrar o rascunho como ideia ao criar (ADR 0044, adendo; ADR 0042).
  draftIdea        Boolean   @default(false) @map("draft_idea")
  ready            Boolean   @default(false)
  createdTicketId  String?   @map("created_ticket_id") @db.Uuid
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization                @relation(fields: [orgId], references: [orgId])
  project            Project                     @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  author             Person                      @relation(fields: [orgId, authorPersonId], references: [orgId, id], onDelete: Cascade)
  createdTicket      Ticket?                     @relation(fields: [orgId, projectId, createdTicketId], references: [orgId, projectId, id], onDelete: Restrict)
  messages           TicketConversationMessage[]
  placementDecisions PlacementDecision[]

  @@id([orgId, id])
  @@index([orgId, projectId, authorPersonId, updatedAt(sort: Desc)])
  @@index([orgId, authorPersonId])
  @@map("ticket_conversations")
}

model TicketConversationMessage {
  orgId          String   @map("org_id")
  id             String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  position       Int
  /// person | assistant (check no banco)
  author         String
  body           String
  /// Modelo que produziu a resposta; só nas mensagens do assistente.
  model          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [orgId], references: [orgId])
  conversation TicketConversation @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@unique([orgId, conversationId, position])
  @@map("ticket_conversation_messages")
}

/// A decisão da procura de lugar (ADR 0052, item 5): só identificadores e números, nenhum texto. Uma por conversa; ao criar o
/// ticket o dono passa a ser o ticket (`conversationId` zerado). Migration 0028.
model PlacementDecision {
  orgId             String   @map("org_id")
  id                String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  conversationId    String?  @map("conversation_id") @db.Uuid
  ticketId          String?  @map("ticket_id") @db.Uuid
  chosenPath        String[] @default([]) @map("chosen_path") @db.Uuid
  /// Lista de caminhos alternativos, cada um uma lista de ids de ticket.
  alternatives      Json     @default("[]")
  uncertain         Boolean
  /// no_candidates | below_low | band | candidates_too_large | max_levels (check no banco)
  stopReason        String?  @map("stop_reason")
  scopeTicketId     String?  @map("scope_ticket_id") @db.Uuid
  scopeFit          Float?   @map("scope_fit")
  /// Um elemento por pergunta ao juiz: { level, parentId, parentNumber (número do pai; null na raiz), result, belongs, candidates: [{ ticketId, number, probability }] }.
  levels            Json     @default("[]")
  /// Os relacionados, em ordem de probabilidade: [{ ticketId, number, sameSubject, sameRequest }] (ADR 0052, fatia 2).
  related           Json     @default("[]")
  /// O relacionado apontado como o mesmo pedido; sem chave estrangeira (a decisão é diagnóstico).
  duplicateTicketId String?  @map("duplicate_ticket_id") @db.Uuid
  /// descent | related_within | related_ancestor | related_choice | choice_unavailable (check no banco)
  placementRule     String?  @map("placement_rule")
  /// A triagem de relacionados (ADR 0053, fatia 2): só números e códigos; `{}` quando não houve triagem por vetor.
  triage            Json     @default("{}")
  // `placed_by` (migration 0032, ADR 0054 adendo) não é mapeada de propósito: a API a lê e grava por SQL cru, tolerando a coluna ausente (42703), para que a ausência dela não derrube a leitura das outras colunas.
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [orgId], references: [orgId])
  project      Project             @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  conversation TicketConversation? @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade)
  ticket       Ticket?             @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@index([orgId, projectId])
  @@map("placement_decisions")
}

/// Um vetor de 512 números por ticket vivo, para a busca por significado (ADR 0053). O vetor é lido e escrito só por SQL cru
/// parametrizado (o Prisma não conhece o tipo `vector`). `contentHash` é o sha256 do texto que o gerou (título e descrição).
model TicketEmbedding {
  orgId       String                     @map("org_id")
  ticketId    String                     @map("ticket_id") @db.Uuid
  projectId   String                     @map("project_id") @db.Uuid
  model       String
  dimensions  Int
  contentHash String                     @map("content_hash")
  embedding   Unsupported("vector(512)")
  updatedAt   DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  ticket       Ticket       @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, ticketId])
  @@index([orgId, projectId])
  @@map("ticket_embeddings")
}

model BranchSummary {
  orgId            String   @map("org_id")
  projectId        String   @map("project_id") @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  summary          String
  /// Registro do conteúdo de que a IA escreveu o texto; não é mais comparado em lugar nenhum (ADR 0033).
  contentMark      String   @map("content_mark")
  /// Modelo que escreveu; nulo se e só se `source = person` (check na migration 0008). O texto vai até 1000 caracteres.
  model            String?
  /// assistant | person (check na migration 0008): quem escreveu por último.
  source           String   @default("assistant")
  editedByPersonId String?  @map("edited_by_person_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  /// Remover a pessoa só anula `editedByPersonId` (SET NULL só na migration 0008).
  editedBy     Person?      @relation(fields: [orgId, editedByPersonId], references: [orgId, id], onDelete: Restrict)

  @@id([orgId, ticketId])
  @@index([orgId, projectId])
  @@map("branch_summaries")
}

/// A instalação do GitHub App da organização (ADR 0032). No máximo uma por organização e uma por instalação do GitHub
/// (índices únicos `org_id` e `installation_id`, este global). Nenhum token é guardado.
model GithubInstallation {
  orgId               String   @map("org_id")
  id                  String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  /// O identificador da instalação no GitHub.
  installationId      BigInt   @unique @map("installation_id")
  accountLogin        String   @map("account_login")
  accountType         String   @map("account_type")
  /// all | selected (check no banco)
  repositorySelection String   @map("repository_selection")
  connectedByPersonId String?  @map("connected_by_person_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [orgId], references: [orgId])
  /// Remover a pessoa só anula `connectedByPersonId` (ON DELETE SET NULL (connected_by_person_id): ver a migration 0007).
  connectedBy  Person?             @relation(fields: [orgId, connectedByPersonId], references: [orgId, id], onDelete: Restrict)
  repositories ProjectRepository[]

  @@id([orgId, id])
  @@unique([orgId])
  @@map("github_installations")
}

/// Repositório da instalação ligado a um projeto (retrato no momento da ligação).
model ProjectRepository {
  orgId             String   @map("org_id")
  id                String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  installationRowId String   @map("installation_row_id") @db.Uuid
  repoId            BigInt   @map("repo_id")
  fullName          String   @map("full_name")
  htmlUrl           String   @map("html_url")
  private           Boolean
  defaultBranch     String   @map("default_branch")
  linkedByPersonId  String?  @map("linked_by_person_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [orgId], references: [orgId])
  project      Project              @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  installation GithubInstallation   @relation(fields: [orgId, installationRowId], references: [orgId, id], onDelete: Cascade)
  /// Remover a pessoa só anula `linkedByPersonId` (SET NULL só na migration 0007).
  linkedBy     Person?              @relation(fields: [orgId, linkedByPersonId], references: [orgId, id], onDelete: Restrict)
  codeLinks    TicketCodeLink[]
  syncPages    RepositorySyncPage[]

  @@id([orgId, id])
  @@unique([orgId, projectId, repoId])
  @@unique([orgId, projectId, id])
  @@index([orgId, installationRowId])
  @@map("project_repositories")
}

/// Branch ou pull request ligado a um ticket pela chave dele (preenchida no passo 2). Os índices únicos parciais
/// (branch por `ref`, pull request por `number`) e os checks vivem só na migration 0007.
model TicketCodeLink {
  orgId               String    @map("org_id")
  id                  String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  ticketId            String    @map("ticket_id") @db.Uuid
  projectRepositoryId String    @map("project_repository_id") @db.Uuid
  /// branch | pull_request (check no banco)
  kind                String
  ref                 String
  number              Int?
  title               String?
  /// branch: active; pull request: open | merged | closed (check no banco)
  state               String
  url                 String
  providerUpdatedAt   DateTime? @map("provider_updated_at") @db.Timestamptz(3)
  seenAt              DateTime  @map("seen_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [orgId], references: [orgId])
  ticket       Ticket            @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  repository   ProjectRepository @relation(fields: [orgId, projectId, projectRepositoryId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@index([orgId, ticketId])
  @@map("ticket_code_links")
}

/// Marca de sincronização por página consultada (ETag), usada no passo 2.
model RepositorySyncPage {
  orgId               String   @map("org_id")
  projectRepositoryId String   @map("project_repository_id") @db.Uuid
  /// branches | pulls (check no banco)
  resource            String
  page                Int
  etag                String?
  syncedAt            DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [orgId], references: [orgId])
  repository   ProjectRepository @relation(fields: [orgId, projectRepositoryId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, projectRepositoryId, resource, page])
  @@map("repository_sync_pages")
}

/// Token de acesso de uma pessoa a um projeto (ADR 0038). Só o resumo SHA-256 do token é guardado.
model AccessToken {
  orgId       String    @map("org_id")
  id          String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  personId    String    @map("person_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  /// 1 a 80 caracteres (check no banco)
  name        String
  /// Os primeiros caracteres do segredo, para a pessoa reconhecer o token na lista.
  tokenPrefix String    @map("token_prefix")
  /// SHA-256 do token inteiro, em hexadecimal; único.
  tokenHash   String    @unique @map("token_hash")
  /// read | write (check no banco; ADR 0043). Não muda depois de criado.
  scope       String    @default("read")
  /// Alcance "pessoas e conversas" (ADR 0062), independente de `scope`. Não muda depois de criado (fora da concessão de UPDATE).
  people      Boolean   @default(false)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@index([orgId, personId])
  @@index([orgId, projectId])
  @@map("access_tokens")
}

/// Aceite da organização para a IA (ADR 0039). Cada aceitar cria uma linha; retirar preenche `withdrawnAt` da linha em
/// vigor; as antigas ficam como registro. No máximo uma linha em vigor por organização e tipo (índice único parcial
/// `organization_consents_in_force_key`, que o Prisma não modela: ver a migration 0013).
model OrganizationConsent {
  orgId               String    @map("org_id")
  id                  String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  /// assistant | code_reading (check no banco)
  kind                String
  /// Versão dos documentos aceita (constante `AI_CONSENT_VERSION` do domínio no momento do aceite).
  documentVersion     String    @map("document_version")
  acceptedByPersonId  String    @map("accepted_by_person_id") @db.Uuid
  acceptedAt          DateTime  @default(now()) @map("accepted_at") @db.Timestamptz(3)
  withdrawnByPersonId String?   @map("withdrawn_by_person_id") @db.Uuid
  withdrawnAt         DateTime? @map("withdrawn_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  acceptedBy   Person       @relation("ConsentAcceptedBy", fields: [orgId, acceptedByPersonId], references: [orgId, id], onDelete: Restrict)
  withdrawnBy  Person?      @relation("ConsentWithdrawnBy", fields: [orgId, withdrawnByPersonId], references: [orgId, id], onDelete: Restrict)

  @@id([orgId, id])
  @@index([orgId, kind])
  @@map("organization_consents")
}

/// Comentário do ticket (ADR 0040). Removido: `removedAt` preenchido e `body` vazio (checks no banco).
model TicketComment {
  orgId             String    @map("org_id")
  id                String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  ticketId          String    @map("ticket_id") @db.Uuid
  /// Nulo só em comentário trazido do Linear (`via = linear`) cujo autor não casou com uma pessoa do TreePM (migration 0044).
  authorPersonId    String?   @map("author_person_id") @db.Uuid
  /// O nome de exibição do autor no Linear (ou do robô), só quando não há pessoa casada; os dois nulos = autor apagado no Linear.
  externalAuthorName String?  @map("external_author_name")
  /// 1 a 10.000 caracteres enquanto existe; vazio depois de removido (check no banco)
  body              String
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt          DateTime? @map("edited_at") @db.Timestamptz(3)
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(3)
  removedByPersonId String?   @map("removed_by_person_id") @db.Uuid
  /// Contribuição (área) do mesmo ticket, ou nulo para comentário do ticket (ADR 0041). A chave estrangeira real é
  /// `ON DELETE SET NULL (contribution_id)` (migration 0017); o Prisma não a expressa.
  contributionId    String?   @map("contribution_id") @db.Uuid
  /// Nome da área que a contribuição removida tinha, gravado por gatilho no banco; nulo enquanto a contribuição existe
  areaName          String?   @map("area_name")
  /// `mcp` quando o comentário veio de uma chamada MCP (ADR 0043), `act-as` quando um administrador o escreveu agindo como pessoa de teste (ADR 0057); `linear` quando foi trazido do Linear (ADR 0061); nulo quando foi escrito na tela. Nunca muda depois.
  via               String?
  /// Com `via = act-as` (ADR 0057): a pessoa de verdade (administrador) que escreveu agindo como `authorPersonId`; nulo nos demais. Nunca é devolvido pela API.
  viaPersonId       String?   @map("via_person_id") @db.Uuid
  /// Repetição de `add_comment` (ADR 0043): id do registro do token e o `requestId` do cliente; os dois nulos fora do MCP.
  requestTokenId    String?   @map("request_token_id") @db.Uuid
  requestId         String?   @map("request_id")

  organization Organization        @relation(fields: [orgId], references: [orgId])
  ticket       Ticket              @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  author       Person?             @relation("CommentAuthor", fields: [orgId, authorPersonId], references: [orgId, id])
  removedBy    Person?             @relation("CommentRemovedBy", fields: [orgId, removedByPersonId], references: [orgId, id])
  contribution TicketContribution? @relation(fields: [orgId, ticketId, contributionId], references: [orgId, ticketId, id], onDelete: NoAction)

  @@id([orgId, id])
  @@index([orgId, ticketId, createdAt, id])
  @@index([orgId, contributionId, createdAt, id])
  @@map("ticket_comments")
}

/// Contribuição de uma área no ticket (ADR 0041): texto em markdown, situação própria e pessoas. Única por ticket e área.
model TicketContribution {
  orgId             String   @map("org_id")
  id                String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  ticketId          String   @map("ticket_id") @db.Uuid
  areaId            String   @map("area_id") @db.Uuid
  /// 0 a 20.000 caracteres (check no banco)
  text              String   @default("")
  /// todo | in_progress | done (check no banco)
  status            String   @default("todo")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByPersonId String   @map("created_by_person_id") @db.Uuid

  organization Organization               @relation(fields: [orgId], references: [orgId])
  ticket       Ticket                     @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  area         Area                       @relation(fields: [orgId, areaId], references: [orgId, id], onDelete: Restrict)
  createdBy    Person                     @relation("ContributionCreatedBy", fields: [orgId, createdByPersonId], references: [orgId, id], onDelete: Restrict)
  people       TicketContributionPerson[]
  comments     TicketComment[]

  @@id([orgId, id])
  @@unique([orgId, ticketId, areaId])
  @@unique([orgId, ticketId, id])
  @@index([orgId, ticketId, createdAt, id])
  @@index([orgId, areaId])
  @@map("ticket_contributions")
}

/// Pessoa de uma contribuição (ADR 0041); não é a linha "Pessoas" do ticket.
model TicketContributionPerson {
  orgId          String   @map("org_id")
  contributionId String   @map("contribution_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [orgId], references: [orgId])
  contribution TicketContribution @relation(fields: [orgId, contributionId], references: [orgId, id], onDelete: Cascade)
  person       Person             @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Restrict)

  @@id([orgId, contributionId, personId])
  @@map("ticket_contribution_people")
}

/// Uma conversa (ADR 0055, migration 0033): a principal de uma pessoa num ticket (`ticket`), o chat geral dela (`general`) ou uma thread
/// dentro de outra conversa (`thread`, até o nível 10). Os índices únicos parciais, as regras da árvore e a invariante dos participantes
/// (filha inclui os da conversa de cima) estão na migration.
model Conversation {
  orgId            String    @map("org_id")
  id               String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  kind             String
  ownerPersonId    String    @map("owner_person_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  ticketId         String?   @map("ticket_id") @db.Uuid
  parentId         String?   @map("parent_id") @db.Uuid
  /// A principal de onde descende (a própria, nas principais)
  rootId           String    @map("root_id") @db.Uuid
  /// 0 nas principais; 1 a 10 nas threads
  depth            Int       @default(0)
  /// A mensagem, da conversa de cima, que abriu a thread
  openingMessageId String?   @map("opening_message_id") @db.Uuid
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  /// A vez do assistente (uma conversa por vez por principal); nulo = livre
  turnStartedAt    DateTime? @map("turn_started_at") @db.Timestamptz(3)
  /// Para que a thread existe: people (entre pessoas), topic (assunto com o assistente, só de quem abriu) ou creation (novo ticket); nulo nas principais. Imutável
  purpose          String?
  /// O título curto da thread de assunto (até 60 caracteres); nulo até a primeira resposta
  title            String?
  /// A conversa de novo ticket de uma thread `creation` (fatia 3)
  ticketConversationId String? @map("ticket_conversation_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization              @relation(fields: [orgId], references: [orgId])
  ticket         Ticket?                   @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade, map: "conversations_ticket_fkey")
  owner          Person                    @relation("ConversationOwner", fields: [orgId, ownerPersonId], references: [orgId, id], onDelete: Cascade, map: "conversations_owner_fkey")
  parent         Conversation?             @relation("ConversationParent", fields: [orgId, parentId], references: [orgId, id], onDelete: Cascade, map: "conversations_parent_fkey")
  children       Conversation[]            @relation("ConversationParent")
  root           Conversation              @relation("ConversationRoot", fields: [orgId, rootId], references: [orgId, id], onDelete: Cascade, map: "conversations_root_fkey")
  descendants    Conversation[]            @relation("ConversationRoot")
  openingMessage ConversationMessage?      @relation("ConversationOpening", fields: [orgId, openingMessageId], references: [orgId, id], onDelete: NoAction, map: "conversations_opening_message_fkey")
  participants   ConversationParticipant[]
  messages       ConversationMessage[]     @relation("ConversationMessages")

  @@id([orgId, id])
  @@map("conversations")
}

/// Quem participa de uma conversa, com o ponto de leitura DA PESSOA nela (ADR 0055); só entra, nunca sai.
model ConversationParticipant {
  orgId           String   @map("org_id")
  conversationId  String   @map("conversation_id") @db.Uuid
  personId        String   @map("person_id") @db.Uuid
  addedByPersonId String?  @map("added_by_person_id") @db.Uuid
  /// Tudo com `seq` até aqui já foi lido por esta pessoa nesta conversa
  lastReadSeq     BigInt   @default(0) @map("last_read_seq")
  /// A pessoa fechou a conversa quando a última mensagem dela tinha este `seq` (nulo = aberta); volta sozinha com mensagem de outro depois disso (ADR 0059)
  closedSeq       BigInt?  @map("closed_seq")
  addedAt         DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  conversation Conversation @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade, map: "conversation_participants_conversation_fkey")
  person       Person       @relation("ConversationParticipantPerson", fields: [orgId, personId], references: [orgId, id], onDelete: Cascade, map: "conversation_participants_person_fkey")
  addedBy      Person?      @relation("ConversationParticipantAddedBy", fields: [orgId, addedByPersonId], references: [orgId, id], onDelete: Restrict, map: "conversation_participants_added_by_fkey")

  @@id([orgId, conversationId, personId])
  @@index([orgId, personId], map: "conversation_participants_person_idx")
  @@map("conversation_participants")
}

/// Mensagem de uma conversa (ADR 0055; era `ticket_chat_messages`). A que abriu uma thread mora na conversa de cima.
model ConversationMessage {
  orgId          String   @map("org_id")
  id             String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  /// Ordem total; ordenação, cursor e ponto de leitura
  seq            BigInt   @default(autoincrement())
  conversationId String   @map("conversation_id") @db.Uuid
  /// Nulo = o assistente
  authorPersonId String?  @map("author_person_id") @db.Uuid
  body           String
  model          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [orgId], references: [orgId])
  conversation Conversation   @relation("ConversationMessages", fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade, map: "conversation_messages_conversation_fkey")
  author       Person?        @relation("ConversationMessageAuthor", fields: [orgId, authorPersonId], references: [orgId, id], map: "conversation_messages_author_fkey")
  opens        Conversation[] @relation("ConversationOpening")

  @@id([orgId, id])
  @@index([orgId, conversationId, seq], map: "conversation_messages_conversation_idx")
  @@map("conversation_messages")
}

/// A chave de API de um provedor externo (Linear), uma por pessoa e provedor (ADR 0060). O segredo vai cifrado (AES-256-GCM) pela
/// aplicação, com organização, pessoa e provedor como dado autenticado. Nunca é lido por rota nenhuma além do próprio dono.
model ExternalCredential {
  orgId                 String   @map("org_id")
  personId              String   @map("person_id") @db.Uuid
  /// linear (check no banco)
  provider              String
  secretCiphertext      Bytes    @map("secret_ciphertext")
  secretNonce           Bytes    @map("secret_nonce")
  keyVersion            Int      @map("key_version")
  externalWorkspaceId   String   @map("external_workspace_id")
  externalWorkspaceName String   @map("external_workspace_name")
  /// Os quatro últimos caracteres da chave, só para a pessoa reconhecê-la.
  secretHint            String   @map("secret_hint")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, personId, provider])
  @@map("external_credentials")
}

/// A ligação PERMANENTE de um projeto com um time do provedor (ADR 0060, seção 2). O papel da aplicação só tem SELECT e INSERT
/// (migration 0037): nunca se altera nem se apaga pela aplicação. O mesmo time não entra em dois projetos da organização.
model ProjectExternalSource {
  orgId                 String   @map("org_id")
  projectId             String   @map("project_id") @db.Uuid
  /// linear (check no banco)
  provider              String
  externalWorkspaceId   String   @map("external_workspace_id")
  externalWorkspaceName String   @map("external_workspace_name")
  externalTeamId        String   @map("external_team_id")
  externalTeamKey       String   @map("external_team_key")
  externalTeamName      String   @map("external_team_name")
  linkedByPersonId      String   @map("linked_by_person_id") @db.Uuid
  linkedAt              DateTime @default(now()) @map("linked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict)
  linkedBy     Person       @relation("ExternalSourceLinkedBy", fields: [orgId, linkedByPersonId], references: [orgId, id])

  @@id([orgId, projectId])
  @@unique([orgId, provider, externalWorkspaceId, externalTeamId])
  @@map("project_external_sources")
}

/// A origem de um ticket no provedor (ADR 0060, seção 5; migration 0038). Única na ORGANIZAÇÃO por provedor, tipo e id externo. Os dois
/// retratos guardam o que veio do provedor e o que foi aplicado aqui; nenhum e-mail do provedor entra. Sem DELETE para a aplicação
/// (some com o ticket).
model TicketExternalRef {
  orgId             String    @map("org_id")
  ticketId          String    @map("ticket_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  /// linear (check no banco)
  provider          String
  /// issue | project (check no banco)
  kind              String
  externalId        String    @map("external_id")
  externalKey       String?   @map("external_key")
  externalUrl       String?   @map("external_url")
  externalParentId  String?   @map("external_parent_id")
  externalProjectId String?   @map("external_project_id")
  sourceSnapshot    Json      @map("source_snapshot")
  appliedSnapshot   Json      @map("applied_snapshot")
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz(3)
  firstImportedAt   DateTime  @default(now()) @map("first_imported_at") @db.Timestamptz(3)
  lastImportedAt    DateTime  @default(now()) @map("last_imported_at") @db.Timestamptz(3)
  missingSince      DateTime? @map("missing_since") @db.Timestamptz(3)
  /// A rodada em que a origem foi vista pela última vez (sem chave estrangeira; migration 0039).
  lastSeenRunId     String?   @map("last_seen_run_id") @db.Uuid
  /// A reimportação viu o pai (ou o projeto) mudar no Linear e a fase `hierarchy` ainda não decidiu.
  hierarchyPending  Boolean   @default(false) @map("hierarchy_pending")
  /// A fase `statuses` precisa avaliar a origem: a situação do Linear mudou, o ticket está em desvio (aplicada ≠ desejada por invariante) ou a hierarquia o tocou.
  statusPending     Boolean   @default(false) @map("status_pending")
  /// Controle da rodada em andamento na fase `statuses` (qual rodada e as marcas 1 atualizado, 2 mexido, 4 avaliado, 8 o Linear mudou a situação).
  statusRunId       String?   @map("status_run_id") @db.Uuid
  statusRunFlags    Int       @default(0) @map("status_run_flags") @db.SmallInt
  /// As datas do Linear (migration 0043; ADR 0061): ficam na origem, o ticket mantém as dele.
  externalCreatedAt   DateTime? @map("external_created_at") @db.Timestamptz(3)
  externalStartedAt   DateTime? @map("external_started_at") @db.Timestamptz(3)
  externalCompletedAt DateTime? @map("external_completed_at") @db.Timestamptz(3)
  externalCanceledAt  DateTime? @map("external_canceled_at") @db.Timestamptz(3)
  /// Identificadores que a issue já teve no Linear (trocou de time); a busca por chave os acha.
  externalPreviousKeys String[] @default([]) @map("external_previous_keys")
  /// O id do criador no Linear (nunca o e-mail).
  externalCreatorId   String?   @map("external_creator_id")
  /// O nome de exibição do criador no Linear: só quando não há pessoa casada.
  externalCreatorName String?   @map("external_creator_name")
  /// A pessoa do TreePM que casou com o criador por e-mail único (a chave estrangeira zera só esta coluna, só no SQL).
  creatorPersonId     String?   @map("creator_person_id") @db.Uuid

  organization Organization @relation(fields: [orgId], references: [orgId])
  ticket       Ticket       @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, ticketId])
  @@unique([orgId, provider, kind, externalId], map: "ticket_external_refs_external_key")
  @@index([orgId, projectId])
  @@index([orgId, projectId, ticketId], map: "ticket_external_refs_project_ticket_idx")
  @@map("ticket_external_refs")
}

/// Origem por item (ADR 0061, seção 3; migration 0044): comentários agora, relações, etiquetas e anexos depois. Única por organização,
/// provedor, tipo e id externo. `localId` é o item local (sem chave estrangeira: o tipo muda de tabela), nulo depois de removido aqui.
model ExternalItemRef {
  orgId             String    @map("org_id")
  id                String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  ticketId          String    @map("ticket_id") @db.Uuid
  /// linear (check no banco)
  provider          String
  /// comment | relation | label (check no banco). Em `label` (migration 0048), `externalId` é `<issue>:<etiqueta>` do Linear e `localId` a etiqueta daqui.
  kind              String
  externalId        String    @map("external_id")
  localId           String?   @map("local_id") @db.Uuid
  /// O que foi aplicado: datas de edição, marca do corpo original, id do usuário e do pai no Linear, se o corpo começa com a citação. Nunca o corpo nem e-mail.
  applied           Json      @default("{}")
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz(3)
  missingSince      DateTime? @map("missing_since") @db.Timestamptz(3)
  removedHereAt     DateTime? @map("removed_here_at") @db.Timestamptz(3)
  /// A rodada que viu o item por último (sem chave estrangeira, como em `ticket_external_refs`).
  lastSeenRunId     String?   @map("last_seen_run_id") @db.Uuid
  firstImportedAt   DateTime  @default(now()) @map("first_imported_at") @db.Timestamptz(3)
  lastImportedAt    DateTime  @default(now()) @map("last_imported_at") @db.Timestamptz(3)
  /// Relação do Linear: o id dela (`applied->>'relationId'`). Coluna GERADA no banco (migration 0045): só leitura, o código nunca a grava.
  relationId        String?   @default(dbgenerated("(applied ->> 'relationId'::text)")) @map("relation_id")

  organization Organization @relation(fields: [orgId], references: [orgId])
  ticket       Ticket       @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@unique([orgId, provider, kind, externalId], map: "external_item_refs_external_key")
  @@index([orgId, ticketId], map: "external_item_refs_ticket_idx")
  @@index([orgId, projectId, kind], map: "external_item_refs_project_kind_idx")
  @@index([orgId, localId], map: "external_item_refs_local_idx")
  // Só no SQL (migration 0045): a expressão da coluna gerada `relation_id` e o índice parcial `(org_id, relation_id) where kind = 'relation'`
  // (as formas de uma relação do Linear); o Prisma não descreve nenhum dos dois.
  @@map("external_item_refs")
}

/// A origem de uma etiqueta do projeto no provedor (ADR 0065; migration 0048): id da etiqueta de lá, nome e cor aplicados. Tabela própria
/// porque SOBREVIVE à etiqueta: apagar a etiqueta aqui zera `labelId` (a aplicação marca `removedHereAt`) e a sincronização não a faz
/// renascer. Única por projeto, provedor e id externo. A aplicação lê, insere e atualiza só o estado; não apaga (some com o projeto).
model ProjectLabelOrigin {
  orgId           String    @map("org_id")
  id              String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  /// linear (check no banco)
  provider        String
  /// 1 a 100 caracteres (check no banco)
  externalId      String    @map("external_id")
  /// A etiqueta daqui; nulo depois de apagada. A chave estrangeira composta (org, projeto, etiqueta) é `ON DELETE SET NULL (label_id)`
  /// (lista de colunas do Postgres 15+), só no SQL da migration 0048: o Prisma não a expressa (o SET NULL dele zeraria também o projeto).
  labelId         String?   @map("label_id") @db.Uuid
  /// 1 a 60 caracteres (check no banco)
  appliedName     String    @map("applied_name")
  /// Uma das oito cores da paleta (check no banco)
  appliedColor    String    @map("applied_color")
  /// Apagada aqui; só com `labelId` nulo (check no banco).
  removedHereAt   DateTime? @map("removed_here_at") @db.Timestamptz(3)
  firstImportedAt DateTime  @default(now()) @map("first_imported_at") @db.Timestamptz(3)
  lastImportedAt  DateTime  @default(now()) @map("last_imported_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade, map: "project_label_origins_project_fkey")

  @@id([orgId, id])
  @@unique([orgId, projectId, provider, externalId], map: "project_label_origins_external_key")
  @@index([orgId, labelId], map: "project_label_origins_label_idx")
  @@map("project_label_origins")
}

/// Uma entrada do histórico de uma issue do Linear (ADR 0061, fatia 4; migration 0046). O item local É a linha. A aplicação lê e insere;
/// atualiza só o autor (acompanha o casamento atual); não apaga (some em cascata com o ticket).
model ExternalHistoryEntry {
  orgId             String   @map("org_id")
  id                String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  ticketId          String   @map("ticket_id") @db.Uuid
  /// linear (check no banco)
  provider          String
  /// O id da entrada (`IssueHistory.id`).
  externalId        String   @map("external_id")
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  /// A pessoa do TreePM casada com o autor (nunca junto de `externalActorName`).
  actorPersonId     String?  @map("actor_person_id") @db.Uuid
  /// Nome de exibição do autor no Linear, ou do robô (1 a 120, nunca com forma de e-mail; check no banco). Nulo com pessoa nula = desconhecido.
  externalActorName String?  @map("external_actor_name")
  /// Lista das mudanças já normalizadas (`LinearHistoryChange[]` do domínio). Nunca e-mail.
  changes           Json     @default("[]")
  firstImportedAt   DateTime @default(now()) @map("first_imported_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  ticket       Ticket       @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  actor        Person?      @relation("HistoryEntryActor", fields: [orgId, actorPersonId], references: [orgId, id], onDelete: Restrict)

  @@id([orgId, id])
  @@unique([orgId, provider, externalId], map: "external_history_entries_external_key")
  @@index([orgId, ticketId, occurredAt], map: "external_history_entries_ticket_idx")
  @@index([orgId, actorPersonId], map: "external_history_entries_actor_idx")
  @@map("external_history_entries")
}

/// Uma rodada de importação de um projeto ligado (ADR 0060, seção 3; migration 0038). No máximo uma não terminada por projeto (índice
/// único parcial, só no SQL). A aplicação lê, cria e atualiza; não apaga.
model ExternalImportRun {
  orgId              String    @map("org_id")
  id                 String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  provider           String
  startedByPersonId  String    @map("started_by_person_id") @db.Uuid
  /// first | reimport | categorize (check no banco)
  mode               String
  /// projects | issues | hierarchy | statuses | mentions | comments | relations | history | missing | categorize | done | failed (check no banco)
  phase              String
  cursor             String?
  destinationTicketId String?  @map("destination_ticket_id") @db.Uuid
  categorize         Boolean   @default(false)
  counts             Json      @default("{}")
  totalExpected      Int?      @map("total_expected")
  waitUntil          DateTime? @map("wait_until") @db.Timestamptz(3)
  lastErrorCode      String?   @map("last_error_code")
  /// Itens por página de issues (1 a 250): cai à metade quando a resposta estoura o teto do corpo.
  pageSize           Int       @default(50) @map("page_size")
  /// Passos seguidos que falharam com o mesmo código (zera no primeiro que grava).
  errorStreak        Int       @default(0) @map("error_streak")
  /// Teto de itens por passo das fases em lote (nulo = o normal de cada fase): cai à metade quando a transação estoura.
  batchSize          Int?      @map("batch_size")
  /// Passos bem-sucedidos seguidos desde a última redução de tamanho: só cresce de novo depois de três.
  sizeStreak         Int       @default(0) @map("size_streak")
  /// Um destino foi escolhido ao abrir: se `destination_ticket_id` virar nulo, o ticket foi apagado.
  hasDestination     Boolean   @default(false) @map("has_destination")
  /// Só no modo `categorize`: a rodada de importação concluída sobre a qual a categorização foi aberta (sem chave estrangeira; migration 0040).
  sourceRunId        String?   @map("source_run_id") @db.Uuid
  /// Fase `history` (migration 0046): o filtro `updatedAt > ...` desta rodada, fixado ao entrar na fase (nulo = o time inteiro).
  historySince       DateTime? @map("history_since") @db.Timestamptz(3)
  /// A fase `history` terminou sem truncamento por erro (só então a marca d'água avança). A marca d'água de um projeto é o maior
  /// `startedAt` entre as rodadas com `historyComplete`.
  historyComplete    Boolean   @default(false) @map("history_complete")
  /// "Sobrescrever com o Linear" (ADR 0066, migration 0049): escolhida ao abrir, só em `reimport`, vale para todos os passos.
  overwrite          Boolean   @default(false)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  startedBy    Person       @relation("ImportRunStartedBy", fields: [orgId, startedByPersonId], references: [orgId, id])
  destination  Ticket?      @relation(fields: [orgId, projectId, destinationTicketId], references: [orgId, projectId, id], onDelete: SetNull)
  categorizeItems ExternalCategorizeItem[]

  @@id([orgId, id])
  @@index([orgId, projectId, startedAt])
  @@map("external_import_runs")
}

/// A lista congelada de candidatos de uma rodada de categorização e o que a procura decidiu de cada um (ADR 0060, seção 6; migration 0040).
/// A aplicação lê, insere e atualiza; não apaga.
model ExternalCategorizeItem {
  orgId         String    @map("org_id")
  id            String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  runId         String    @map("run_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  ticketId      String    @map("ticket_id") @db.Uuid
  position      Int
  /// pending | placed | to_check | kept | skipped | failed (check no banco)
  state         String    @default("pending")
  attempts      Int       @default(0)
  /// Limites de taxa seguidos no mesmo candidato: na 10ª espera ele vira `failed`.
  waits         Int       @default(0)
  /// O pai do ticket quando foi decidido: "a conferir" só continua na lista enquanto o pai for este.
  parentBefore  String?   @map("parent_before") @db.Uuid
  /// O caminho sugerido (ids, da raiz ao lugar), só em `to_check`.
  suggestedPath String[]  @default([]) @map("suggested_path") @db.Uuid
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(3)
  dismissedAt   DateTime? @map("dismissed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [orgId], references: [orgId])
  run          ExternalImportRun @relation(fields: [orgId, runId], references: [orgId, id], onDelete: Cascade)
  ticket       Ticket            @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@unique([orgId, runId, ticketId], map: "external_categorize_items_run_ticket_key")
  @@index([orgId, runId, state, position], map: "external_categorize_items_run_idx")
  @@index([orgId, projectId, ticketId], map: "external_categorize_items_ticket_idx")
  @@map("external_categorize_items")
}
