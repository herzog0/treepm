generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ClerkRole {
  admin
  member

  @@map("clerk_role")
}

enum TeamRole {
  admin
  member

  @@map("team_role")
}

enum ProjectVisibility {
  organization
  private

  @@map("project_visibility")
}

enum ProjectRole {
  manager
  contributor
  reader

  @@map("project_role")
}

model Organization {
  orgId           String   @id @map("org_id")
  name            String
  slug            String
  /// "Permitir acesso por MCP" (ADR 0038): desligada por padrão; só um administrador liga.
  mcpEnabled      Boolean  @default(false) @map("mcp_enabled")
  /// "Permitir escrita por MCP" (ADR 0043): desligada por padrão; só um administrador liga. Com ela desligada, nenhum token escreve.
  mcpWriteEnabled Boolean  @default(false) @map("mcp_write_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  people                     Person[]
  teams                      Team[]
  teamMemberships            TeamMembership[]
  areas                      Area[]
  projects                   Project[]
  projectTeams               ProjectTeam[]
  projectMemberships         ProjectMembership[]
  tickets                    Ticket[]
  ticketAssignees            TicketAssignee[]
  ticketRelations            TicketRelation[]
  activityEvents             ActivityEvent[]
  ticketConversations        TicketConversation[]
  ticketConversationMessages TicketConversationMessage[]
  branchSummaries            BranchSummary[]
  githubInstallations        GithubInstallation[]
  projectRepositories        ProjectRepository[]
  ticketCodeLinks            TicketCodeLink[]
  repositorySyncPages        RepositorySyncPage[]
  accessTokens               AccessToken[]
  ticketComments             TicketComment[]
  ticketContributions        TicketContribution[]
  ticketContributionPeople   TicketContributionPerson[]
  organizationConsents       OrganizationConsent[]

  @@map("organizations")
}

model Person {
  orgId       String    @map("org_id")
  id          String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  clerkUserId String    @map("clerk_user_id")
  displayName String    @map("display_name")
  email       String
  avatarUrl   String?   @map("avatar_url")
  clerkRole   ClerkRole @map("clerk_role")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization           Organization               @relation(fields: [orgId], references: [orgId])
  teamMemberships        TeamMembership[]
  projectMemberships     ProjectMembership[]
  createdTickets         Ticket[]                   @relation("TicketCreatedBy")
  ticketsAgentWork       Ticket[]                   @relation("TicketAgentWorkPerson")
  ticketAssignees        TicketAssignee[]
  activityEvents         ActivityEvent[]
  ticketConversations    TicketConversation[]
  connectedInstallations GithubInstallation[]
  linkedRepositories     ProjectRepository[]
  editedBranchSummaries  BranchSummary[]
  accessTokens           AccessToken[]
  commentsWritten        TicketComment[]            @relation("CommentAuthor")
  commentsRemoved        TicketComment[]            @relation("CommentRemovedBy")
  contributionsCreated   TicketContribution[]       @relation("ContributionCreatedBy")
  contributionPeople     TicketContributionPerson[]
  consentsAccepted       OrganizationConsent[]      @relation("ConsentAcceptedBy")
  consentsWithdrawn      OrganizationConsent[]      @relation("ConsentWithdrawnBy")

  @@id([orgId, id])
  @@unique([orgId, clerkUserId])
  @@map("people")
}

model Team {
  orgId     String   @map("org_id")
  id        String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [orgId], references: [orgId])
  memberships  TeamMembership[]
  projectTeams ProjectTeam[]

  @@id([orgId, id])
  @@unique([orgId, name])
  @@map("teams")
}

model TeamMembership {
  orgId     String   @map("org_id")
  teamId    String   @map("team_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  role      TeamRole @default(member)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  team         Team         @relation(fields: [orgId, teamId], references: [orgId, id], onDelete: Cascade)
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, teamId, personId])
  @@map("team_memberships")
}

model Area {
  orgId     String   @map("org_id")
  id        String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization         @relation(fields: [orgId], references: [orgId])
  contributions TicketContribution[]

  @@id([orgId, id])
  @@unique([orgId, name])
  @@map("areas")
}

model Project {
  orgId            String            @map("org_id")
  id               String            @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name             String
  key              String
  visibility       ProjectVisibility @default(organization)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  nextTicketNumber Int               @default(1) @map("next_ticket_number")
  /// Versão da lista de tickets (ADR 0046): contador incrementado em 1 pelo toque do fim da transação, sem relógio.
  ticketsVersion   BigInt            @default(0) @map("tickets_version")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [orgId], references: [orgId])
  teams               ProjectTeam[]
  memberships         ProjectMembership[]
  tickets             Ticket[]
  ticketConversations TicketConversation[]
  branchSummaries     BranchSummary[]
  repositories        ProjectRepository[]
  accessTokens        AccessToken[]

  @@id([orgId, id])
  @@unique([orgId, key])
  @@map("projects")
}

model ProjectTeam {
  orgId     String   @map("org_id")
  projectId String   @map("project_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  team         Team         @relation(fields: [orgId, teamId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, projectId, teamId])
  @@map("project_teams")
}

model ProjectMembership {
  orgId     String      @map("org_id")
  projectId String      @map("project_id") @db.Uuid
  personId  String      @map("person_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, projectId, personId])
  @@map("project_memberships")
}

model Ticket {
  orgId              String    @map("org_id")
  id                 String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  number             Int
  parentId           String?   @map("parent_id") @db.Uuid
  title              String
  description        String    @default("")
  /// todo | in_progress | in_review | done | cancelled (check no banco)
  status             String    @default("todo")
  /// Estágio de ideia (ADR 0042): new | refining | ready | discarded (check no banco); só a raiz da ideia tem. Com estágio, a situação é sempre todo.
  ideaStage          String?   @map("idea_stage")
  /// Prioridade (ADR 0047): inteiro de -999 a 999 (check no banco), 0 por padrão; maior primeiro. A que vale, com herança, é calculada no domínio.
  priority           Int       @default(0)
  /// Marcador de trabalho pela IA (ADR 0043): os quatro andam juntos (check). Vale enquanto `agentWorkUntil` é futuro; nota vazia = sem nota.
  agentWorkStartedAt DateTime? @map("agent_work_started_at") @db.Timestamptz(3)
  agentWorkUntil     DateTime? @map("agent_work_until") @db.Timestamptz(3)
  agentWorkPersonId  String?   @map("agent_work_person_id") @db.Uuid
  agentWorkNote      String?   @map("agent_work_note")
  createdByPersonId  String    @map("created_by_person_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization         @relation(fields: [orgId], references: [orgId])
  project              Project              @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  parent               Ticket?              @relation("TicketTree", fields: [orgId, projectId, parentId], references: [orgId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  children             Ticket[]             @relation("TicketTree")
  createdBy            Person               @relation("TicketCreatedBy", fields: [orgId, createdByPersonId], references: [orgId, id])
  agentWorkPerson      Person?              @relation("TicketAgentWorkPerson", fields: [orgId, agentWorkPersonId], references: [orgId, id])
  assignees            TicketAssignee[]
  conversationsCreated TicketConversation[]
  branchSummaries      BranchSummary[]
  codeLinks            TicketCodeLink[]
  relationsFrom        TicketRelation[]     @relation("RelationFrom")
  relationsTo          TicketRelation[]     @relation("RelationTo")
  comments             TicketComment[]
  contributions        TicketContribution[]

  @@id([orgId, id])
  @@unique([orgId, projectId, id])
  @@unique([orgId, projectId, number])
  @@index([orgId, projectId, parentId])
  @@map("tickets")
}

/// Ligação entre dois tickets do mesmo projeto (ADR 0037): "de" menciona "para" ou "de" depende de "para".
model TicketRelation {
  orgId        String   @map("org_id")
  id           String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  fromTicketId String   @map("from_ticket_id") @db.Uuid
  toTicketId   String   @map("to_ticket_id") @db.Uuid
  /// mentions | depends_on (check no banco)
  kind         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  from         Ticket       @relation("RelationFrom", fields: [orgId, projectId, fromTicketId], references: [orgId, projectId, id], onDelete: Cascade)
  to           Ticket       @relation("RelationTo", fields: [orgId, projectId, toTicketId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@unique([orgId, fromTicketId, toTicketId, kind])
  @@index([orgId, toTicketId, kind])
  @@map("ticket_relations")
}

model TicketAssignee {
  orgId     String   @map("org_id")
  ticketId  String   @map("ticket_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  ticket       Ticket       @relation(fields: [orgId, ticketId], references: [orgId, id], onDelete: Cascade)
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, ticketId, personId])
  @@map("ticket_assignees")
}

model ActivityEvent {
  orgId         String   @map("org_id")
  id            String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  actorPersonId String?  @map("actor_person_id") @db.Uuid
  kind          String
  subjectType   String   @map("subject_type")
  subjectId     String   @map("subject_id")
  payload       Json     @default("{}")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  actor        Person?      @relation(fields: [orgId, actorPersonId], references: [orgId, id])

  @@id([orgId, id])
  @@index([orgId, subjectType, subjectId, occurredAt])
  @@map("activity_events")
}

/// open | ticket_created | discarded (check no banco). Remover o ticket criado só anula `createdTicketId`
/// (ON DELETE SET NULL (created_ticket_id), ação que o Prisma não modela: ver a migration 0005).
model TicketConversation {
  orgId            String    @map("org_id")
  id               String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  authorPersonId   String    @map("author_person_id") @db.Uuid
  status           String    @default("open")
  draftTitle       String?   @map("draft_title")
  draftDescription String?   @map("draft_description")
  /// Filhos do rascunho (ADR 0044): lista de `{ title, description }` na ordem do rascunho, até 20; nulo = um ticket só.
  draftChildren    Json?     @map("draft_children")
  /// Registrar o rascunho como ideia ao criar (ADR 0044, adendo; ADR 0042).
  draftIdea        Boolean   @default(false) @map("draft_idea")
  ready            Boolean   @default(false)
  createdTicketId  String?   @map("created_ticket_id") @db.Uuid
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization                @relation(fields: [orgId], references: [orgId])
  project       Project                     @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  author        Person                      @relation(fields: [orgId, authorPersonId], references: [orgId, id], onDelete: Cascade)
  createdTicket Ticket?                     @relation(fields: [orgId, projectId, createdTicketId], references: [orgId, projectId, id], onDelete: Restrict)
  messages      TicketConversationMessage[]

  @@id([orgId, id])
  @@index([orgId, projectId, authorPersonId, updatedAt(sort: Desc)])
  @@index([orgId, authorPersonId])
  @@map("ticket_conversations")
}

model TicketConversationMessage {
  orgId          String   @map("org_id")
  id             String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  position       Int
  /// person | assistant (check no banco)
  author         String
  body           String
  /// Modelo que produziu a resposta; só nas mensagens do assistente.
  model          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [orgId], references: [orgId])
  conversation TicketConversation @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@unique([orgId, conversationId, position])
  @@map("ticket_conversation_messages")
}

model BranchSummary {
  orgId            String   @map("org_id")
  projectId        String   @map("project_id") @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  summary          String
  /// Registro do conteúdo de que a IA escreveu o texto; não é mais comparado em lugar nenhum (ADR 0033).
  contentMark      String   @map("content_mark")
  /// Modelo que escreveu; nulo se e só se `source = person` (check na migration 0008). O texto vai até 1000 caracteres.
  model            String?
  /// assistant | person (check na migration 0008): quem escreveu por último.
  source           String   @default("assistant")
  editedByPersonId String?  @map("edited_by_person_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  /// Remover a pessoa só anula `editedByPersonId` (SET NULL só na migration 0008).
  editedBy     Person?      @relation(fields: [orgId, editedByPersonId], references: [orgId, id], onDelete: Restrict)

  @@id([orgId, ticketId])
  @@index([orgId, projectId])
  @@map("branch_summaries")
}

/// A instalação do GitHub App da organização (ADR 0032). No máximo uma por organização e uma por instalação do GitHub
/// (índices únicos `org_id` e `installation_id`, este global). Nenhum token é guardado.
model GithubInstallation {
  orgId               String   @map("org_id")
  id                  String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  /// O identificador da instalação no GitHub.
  installationId      BigInt   @unique @map("installation_id")
  accountLogin        String   @map("account_login")
  accountType         String   @map("account_type")
  /// all | selected (check no banco)
  repositorySelection String   @map("repository_selection")
  connectedByPersonId String?  @map("connected_by_person_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [orgId], references: [orgId])
  /// Remover a pessoa só anula `connectedByPersonId` (ON DELETE SET NULL (connected_by_person_id): ver a migration 0007).
  connectedBy  Person?             @relation(fields: [orgId, connectedByPersonId], references: [orgId, id], onDelete: Restrict)
  repositories ProjectRepository[]

  @@id([orgId, id])
  @@unique([orgId])
  @@map("github_installations")
}

/// Repositório da instalação ligado a um projeto (retrato no momento da ligação).
model ProjectRepository {
  orgId             String   @map("org_id")
  id                String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  installationRowId String   @map("installation_row_id") @db.Uuid
  repoId            BigInt   @map("repo_id")
  fullName          String   @map("full_name")
  htmlUrl           String   @map("html_url")
  private           Boolean
  defaultBranch     String   @map("default_branch")
  linkedByPersonId  String?  @map("linked_by_person_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [orgId], references: [orgId])
  project      Project              @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  installation GithubInstallation   @relation(fields: [orgId, installationRowId], references: [orgId, id], onDelete: Cascade)
  /// Remover a pessoa só anula `linkedByPersonId` (SET NULL só na migration 0007).
  linkedBy     Person?              @relation(fields: [orgId, linkedByPersonId], references: [orgId, id], onDelete: Restrict)
  codeLinks    TicketCodeLink[]
  syncPages    RepositorySyncPage[]

  @@id([orgId, id])
  @@unique([orgId, projectId, repoId])
  @@unique([orgId, projectId, id])
  @@index([orgId, installationRowId])
  @@map("project_repositories")
}

/// Branch ou pull request ligado a um ticket pela chave dele (preenchida no passo 2). Os índices únicos parciais
/// (branch por `ref`, pull request por `number`) e os checks vivem só na migration 0007.
model TicketCodeLink {
  orgId               String    @map("org_id")
  id                  String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  ticketId            String    @map("ticket_id") @db.Uuid
  projectRepositoryId String    @map("project_repository_id") @db.Uuid
  /// branch | pull_request (check no banco)
  kind                String
  ref                 String
  number              Int?
  title               String?
  /// branch: active; pull request: open | merged | closed (check no banco)
  state               String
  url                 String
  providerUpdatedAt   DateTime? @map("provider_updated_at") @db.Timestamptz(3)
  seenAt              DateTime  @map("seen_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [orgId], references: [orgId])
  ticket       Ticket            @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  repository   ProjectRepository @relation(fields: [orgId, projectId, projectRepositoryId], references: [orgId, projectId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@index([orgId, ticketId])
  @@map("ticket_code_links")
}

/// Marca de sincronização por página consultada (ETag), usada no passo 2.
model RepositorySyncPage {
  orgId               String   @map("org_id")
  projectRepositoryId String   @map("project_repository_id") @db.Uuid
  /// branches | pulls (check no banco)
  resource            String
  page                Int
  etag                String?
  syncedAt            DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [orgId], references: [orgId])
  repository   ProjectRepository @relation(fields: [orgId, projectRepositoryId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, projectRepositoryId, resource, page])
  @@map("repository_sync_pages")
}

/// Token de acesso de uma pessoa a um projeto (ADR 0038). Só o resumo SHA-256 do token é guardado.
model AccessToken {
  orgId       String    @map("org_id")
  id          String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  personId    String    @map("person_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  /// 1 a 80 caracteres (check no banco)
  name        String
  /// Os primeiros caracteres do segredo, para a pessoa reconhecer o token na lista.
  tokenPrefix String    @map("token_prefix")
  /// SHA-256 do token inteiro, em hexadecimal; único.
  tokenHash   String    @unique @map("token_hash")
  /// read | write (check no banco; ADR 0043). Não muda depois de criado.
  scope       String    @default("read")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  person       Person       @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Cascade)
  project      Project      @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, id])
  @@index([orgId, personId])
  @@index([orgId, projectId])
  @@map("access_tokens")
}

/// Aceite da organização para a IA (ADR 0039). Cada aceitar cria uma linha; retirar preenche `withdrawnAt` da linha em
/// vigor; as antigas ficam como registro. No máximo uma linha em vigor por organização e tipo (índice único parcial
/// `organization_consents_in_force_key`, que o Prisma não modela: ver a migration 0013).
model OrganizationConsent {
  orgId               String    @map("org_id")
  id                  String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  /// assistant | code_reading (check no banco)
  kind                String
  /// Versão dos documentos aceita (constante `AI_CONSENT_VERSION` do domínio no momento do aceite).
  documentVersion     String    @map("document_version")
  acceptedByPersonId  String    @map("accepted_by_person_id") @db.Uuid
  acceptedAt          DateTime  @default(now()) @map("accepted_at") @db.Timestamptz(3)
  withdrawnByPersonId String?   @map("withdrawn_by_person_id") @db.Uuid
  withdrawnAt         DateTime? @map("withdrawn_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [orgId])
  acceptedBy   Person       @relation("ConsentAcceptedBy", fields: [orgId, acceptedByPersonId], references: [orgId, id], onDelete: Restrict)
  withdrawnBy  Person?      @relation("ConsentWithdrawnBy", fields: [orgId, withdrawnByPersonId], references: [orgId, id], onDelete: Restrict)

  @@id([orgId, id])
  @@index([orgId, kind])
  @@map("organization_consents")
}

/// Comentário do ticket (ADR 0040). Removido: `removedAt` preenchido e `body` vazio (checks no banco).
model TicketComment {
  orgId             String    @map("org_id")
  id                String    @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  ticketId          String    @map("ticket_id") @db.Uuid
  authorPersonId    String    @map("author_person_id") @db.Uuid
  /// 1 a 10.000 caracteres enquanto existe; vazio depois de removido (check no banco)
  body              String
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt          DateTime? @map("edited_at") @db.Timestamptz(3)
  removedAt         DateTime? @map("removed_at") @db.Timestamptz(3)
  removedByPersonId String?   @map("removed_by_person_id") @db.Uuid
  /// Contribuição (área) do mesmo ticket, ou nulo para comentário do ticket (ADR 0041). A chave estrangeira real é
  /// `ON DELETE SET NULL (contribution_id)` (migration 0017); o Prisma não a expressa.
  contributionId    String?   @map("contribution_id") @db.Uuid
  /// Nome da área que a contribuição removida tinha, gravado por gatilho no banco; nulo enquanto a contribuição existe
  areaName          String?   @map("area_name")
  /// `mcp` quando o comentário veio de uma chamada MCP (ADR 0043); nulo quando foi escrito na tela. Nunca muda depois.
  via               String?
  /// Repetição de `add_comment` (ADR 0043): id do registro do token e o `requestId` do cliente; os dois nulos fora do MCP.
  requestTokenId    String?   @map("request_token_id") @db.Uuid
  requestId         String?   @map("request_id")

  organization Organization        @relation(fields: [orgId], references: [orgId])
  ticket       Ticket              @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  author       Person              @relation("CommentAuthor", fields: [orgId, authorPersonId], references: [orgId, id])
  removedBy    Person?             @relation("CommentRemovedBy", fields: [orgId, removedByPersonId], references: [orgId, id])
  contribution TicketContribution? @relation(fields: [orgId, ticketId, contributionId], references: [orgId, ticketId, id], onDelete: NoAction)

  @@id([orgId, id])
  @@index([orgId, ticketId, createdAt, id])
  @@index([orgId, contributionId, createdAt, id])
  @@map("ticket_comments")
}

/// Contribuição de uma área no ticket (ADR 0041): texto em markdown, situação própria e pessoas. Única por ticket e área.
model TicketContribution {
  orgId             String   @map("org_id")
  id                String   @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  ticketId          String   @map("ticket_id") @db.Uuid
  areaId            String   @map("area_id") @db.Uuid
  /// 0 a 20.000 caracteres (check no banco)
  text              String   @default("")
  /// todo | in_progress | done (check no banco)
  status            String   @default("todo")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByPersonId String   @map("created_by_person_id") @db.Uuid

  organization Organization               @relation(fields: [orgId], references: [orgId])
  ticket       Ticket                     @relation(fields: [orgId, projectId, ticketId], references: [orgId, projectId, id], onDelete: Cascade)
  area         Area                       @relation(fields: [orgId, areaId], references: [orgId, id], onDelete: Restrict)
  createdBy    Person                     @relation("ContributionCreatedBy", fields: [orgId, createdByPersonId], references: [orgId, id], onDelete: Restrict)
  people       TicketContributionPerson[]
  comments     TicketComment[]

  @@id([orgId, id])
  @@unique([orgId, ticketId, areaId])
  @@unique([orgId, ticketId, id])
  @@index([orgId, ticketId, createdAt, id])
  @@index([orgId, areaId])
  @@map("ticket_contributions")
}

/// Pessoa de uma contribuição (ADR 0041); não é a linha "Pessoas" do ticket.
model TicketContributionPerson {
  orgId          String   @map("org_id")
  contributionId String   @map("contribution_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [orgId], references: [orgId])
  contribution TicketContribution @relation(fields: [orgId, contributionId], references: [orgId, id], onDelete: Cascade)
  person       Person             @relation(fields: [orgId, personId], references: [orgId, id], onDelete: Restrict)

  @@id([orgId, contributionId, personId])
  @@map("ticket_contribution_people")
}
