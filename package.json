{
  "name": "treepm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @treepm/engine build && pnpm --parallel --filter @treepm/engine --filter @treepm/web dev",
    "build": "pnpm --filter @treepm/engine build && pnpm --filter @treepm/web build",
    "typecheck": "pnpm --filter @treepm/engine build && pnpm --filter @treepm/web typecheck",
    "lint": "eslint .",
    "clean": "pnpm --parallel --filter @treepm/engine --filter @treepm/web clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
