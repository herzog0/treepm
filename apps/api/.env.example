DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
APP_ORIGIN=
# Só desenvolvimento: outras origens da web aceitas além de APP_ORIGIN, separadas por vírgula (até 5; https, ou http em localhost/127.0.0.1).
# APP_EXTRA_ORIGINS=
CLERK_JWT_KEY=
PORT=
WEB_DIST_DIR=
# Nome do cabeçalho com o IP do cliente (ex.: Fly-Client-IP), só para o limite por IP do servidor MCP. Vazio = IP da conexão.
CLIENT_IP_HEADER=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Opcional: vetores da busca por significado (Voyage AI, ADR 0053). Sem ela o assistente segue ligado e a busca usa só palavras.
VOYAGE_API_KEY=
# Opcional: como a busca de relacionados usa os vetores. `off` (padrão): só palavras, sem ler vetores nem chamar a Voyage; `rrf`: soma de posições; `interleave`: intercalação.
SEMANTIC_TRIAGE=off
# Opcional: tipo da consulta enviada à Voyage nas duas rotas, `query` (padrão) ou `document`.
SEMANTIC_QUERY_KIND=query
