DATABASE_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
APP_ORIGIN=
# Só desenvolvimento: outras origens da web aceitas além de APP_ORIGIN, separadas por vírgula (até 5; https, ou http em localhost/127.0.0.1).
# APP_EXTRA_ORIGINS=
CLERK_JWT_KEY=
PORT=
WEB_DIST_DIR=
# Nome do cabeçalho com o IP do cliente (ex.: Fly-Client-IP), só para o limite por IP do servidor MCP. Vazio = IP da conexão.
CLIENT_IP_HEADER=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Opcional: vetores da busca por significado (Voyage AI, ADR 0053). Sem ela o assistente segue ligado e a busca usa só palavras.
VOYAGE_API_KEY=
# Opcional: chave de cifra das credenciais de terceiros guardadas por pessoa (ADR 0060): base64 de exatamente 32 bytes (ex.: `openssl rand -base64 32`). Sem ela a API sobe e a ligação com o Linear fica desligada. Perdê-la torna as chaves gravadas ilegíveis (as pessoas colam de novo).
CREDENTIALS_ENCRYPTION_KEY=
# Opcional: como a busca de relacionados usa os vetores. `off` (padrão): só palavras, sem ler vetores nem chamar a Voyage; `rrf`: soma de posições; `interleave`: intercalação.
SEMANTIC_TRIAGE=off
# Opcional: tipo da consulta enviada à Voyage nas duas rotas, `query` (padrão) ou `document`.
SEMANTIC_QUERY_KIND=query
# Opcional: quando a procura do lugar PERGUNTA em vez de propor (ADR 0054). LOW e HIGH são a faixa em que "cabe em algum ramo" é dúvida (0 ≤ LOW < HIGH ≤ 1); CHOICE é a probabilidade abaixo da qual o ramo escolhido não se destaca. A largura é de Teodoro, pela curva medida.
PLACEMENT_DOUBT_LOW=0.2
PLACEMENT_DOUBT_HIGH=0.8
PLACEMENT_DOUBT_CHOICE=0.5
