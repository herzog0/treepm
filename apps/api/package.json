{
  "name": "@treepm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local --tsconfig tsconfig.json src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "measure:conversation": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/measure-conversation.ts",
    "verify:providers": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/verify-providers.ts",
    "github:check": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/github-check.ts",
    "placement:rebuild": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/placement-rebuild.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@clerk/backend": "^3.31.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@treepm/db": "workspace:*",
    "@treepm/domain": "workspace:*",
    "@typesafe-ai/sdk": "^0.7.0",
    "octokit": "^5.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@nestjs/testing": "^12.5.1",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pg": "^8.23.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
