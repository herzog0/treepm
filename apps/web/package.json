{
  "name": "@treepm/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --port 5173",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clerk/localizations": "^4.26.0",
    "@clerk/react": "^6.19.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "@treepm/domain": "workspace:*",
    "@treepm/engine": "workspace:*",
    "@treepm/react": "workspace:*",
    "i18next": "^27.2.2",
    "marked": "17.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.3",
    "zod": "^4.6.7"
