    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "5.1.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest-browser-react": "^2.3.0"
  }
